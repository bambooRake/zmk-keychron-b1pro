#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// Override &mt: hold = sticky-style modifier (delayed release), tap = kp.
// Mirrors LalaPadGen2 keymap convention so home-row mods feel identical
// between the two keyboards.
&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
    bindings = <&sticky_mod>, <&kp>;
};

&lt { quick-tap-ms = <200>; };

/ {
    // ============================================================
    // Behaviors ported from LalaPadGen2
    // ============================================================

    sticky_mod: sticky_mod {
        compatible = "zmk,behavior-macro-one-param";
        #binding-cells = <1>;
        wait-ms = <0>;
        tap-ms = <0>;
        bindings =
            <&macro_param_1to1>,
            <&macro_press>,
            <&kp MACRO_PLACEHOLDER>,
            <&macro_pause_for_release>,
            <&macro_wait_time 400>,
            <&none>,
            <&macro_wait_time 0>,
            <&macro_param_1to1>,
            <&macro_release>,
            <&kp MACRO_PLACEHOLDER>;
        label = "STICKY_MOD";
    };

    tap_key: tap_key {
        compatible = "zmk,behavior-macro-one-param";
        #binding-cells = <1>;
        wait-ms = <0>;
        tap-ms = <0>;
        bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;
        label = "TAP_KEY";
    };

    mt_tap: mt_tap {
        compatible = "zmk,behavior-hold-tap";
        label = "MT_TAP";
        #binding-cells = <2>;
        tapping-term-ms = <200>;
        flavor = "balanced";
        bindings = <&tap_key>, <&kp>;
    };

    mt2: mod_tap2 {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <200>;
        quick-tap-ms = <200>;
        require-prior-idle-ms = <125>;
        bindings = <&kp>, <&kp>;
    };

    lm: lm {
        compatible = "zmk,behavior-macro-two-param";
        wait-ms = <0>;
        tap-ms = <0>;
        #binding-cells = <2>;
        bindings =
            <&macro_param_1to1>,
            <&macro_press>,
            <&mo MACRO_PLACEHOLDER &macro_param_2to1>,
            <&macro_press>,
            <&kp MACRO_PLACEHOLDER>,
            <&macro_pause_for_release>,
            <&macro_param_2to1>,
            <&macro_release>,
            <&kp MACRO_PLACEHOLDER &macro_param_1to1>,
            <&macro_release>,
            <&mo MACRO_PLACEHOLDER>;
    };

    tp_msc_up_left: tp_msc_up_left {
        compatible = "zmk,behavior-tap-dance";
        label = "TP_MSC_UP_LEFT";
        #binding-cells = <0>;
        tapping-term-ms = <300>;
        bindings = <&msc SCRL_UP>, <&msc SCRL_LEFT>;
    };

    tp_msc_down_right: tp_msc_down_right {
        compatible = "zmk,behavior-tap-dance";
        label = "TP_MSC_DOWN_RIGHT";
        #binding-cells = <0>;
        tapping-term-ms = <300>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_RIGHT>;
    };

    tp_mkp_mb4_mb5: tp_mkp_mb4_mb5 {
        compatible = "zmk,behavior-tap-dance";
        label = "TP_MKP_MB4_MB5";
        #binding-cells = <0>;
        tapping-term-ms = <300>;
        bindings = <&mkp MB4>, <&mkp MB5>;
    };

    // ============================================================
    // Existing Keychron B1 Pro behaviors (unchanged)
    // ============================================================

    ZMK_MACRO(recover, bindings = <&out OUT_RECOVER>;)
    ZMK_MACRO(change, bindings = <&out OUT_FN>;)
    ZMK_MACRO(fn_win, bindings = <&out OUT_FN_WIN>;)

    ZMK_MACRO(en_bootloader, bindings = <&bootloader>;)
    ZMK_MACRO1(MA,bindings=<&kp 0x770000>;)

    long_press_recover:l1 {
        compatible = "zmk,behavior-hold-tap";
        label = "l1";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;
        bindings = <&recover>, <&none>;
    };

    long_press_change:l2{
        compatible = "zmk,behavior-hold-tap";
        label = "lp_change";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;
        bindings = <&change>, <&none>;
    };
    long_press_bootloader:l3{
        compatible = "zmk,behavior-hold-tap";
        label = "lp_bootloader";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;
        bindings = <&en_bootloader>, <&none>;
    };
    long_press_fn_win:l4{
        compatible = "zmk,behavior-hold-tap";
        label = "lp_fn_win";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;
        bindings = <&fn_win>, <&none>;
    };


    combos1 {
        compatible = "zmk,combos";
        // Ported from LalaPadGen2 COMBO_TAB_ALT.
        // Activate layer 2 (Tertiary / nav+mouse) with LEFT_ALT held.
        // Trigger: FN(mo 1) + T  ->  positions 76 + 34 on B1 Pro JIS.
        combo_tab_alt {
            timeout-ms = <300>;
            layers = <0>;
            key-positions = <76 34>;
            bindings = <&lm 2 LEFT_ALT>;
            slow-release;
        };
        // NOT ported from LalaPadGen2:
        //   - CONBO_ESC (Q+W = ESC): B1 Pro has a dedicated ESC key.
        //   - COMBO_TAB (A+S = TAB): B1 Pro has a dedicated TAB key.

        // Existing B1 Pro combos. OS switch removed, so layer 1 (Fn) only.
        combo_jz {
            timeout-ms = <1000>;
            layers = <1>;
            key-positions = <49 57>; //fn+j+z
            bindings = <&long_press_recover 0 0>;
        };
        combo_xl {
            timeout-ms = <1000>;
            layers = <1>;
            key-positions = <58 51>; //fn+x+l
            bindings = <&long_press_change 0 0>;
        };
        combo_b {
            timeout-ms = <1000>;
            layers = <1>;
            //slow-release = <true>;
            key-positions = <61>; //fn+b
            bindings = <&out OUT_BAT>;
        };

        combo_win_l {
            timeout-ms = <1000>;
            layers = <1>;
            //slow-release = <true>;
            key-positions = <70>; //fn+win
            bindings = <&long_press_fn_win 0 0>;
        };

        combo_t0 {
            timeout-ms = <10 >;
            layers =<4>;

            key-positions = <80 90>;
            bindings = <&to 3 >;
        };
        combo_t1 {
            timeout-ms = <10 >;
            layers =<4>;

            key-positions = <80 91>;
            bindings = <&tog 3 >;
        };
        combo_t2 {
            timeout-ms = <10 >;
            layers =<4>;

            key-positions = <80 92>;
            bindings = <&sl 3 >;
        };
        combo_t3 {
            timeout-ms = <10 >;
            layers =<4>;

            key-positions = <70 93>;
            bindings = <&lt 3 SPACE>;
        };
        combo_t4 {
            timeout-ms = <10 >;
            layers =<4>;

            key-positions = <81 94>;
            bindings = <&sk LSHIFT>;
        };
        combo_t5 {
            timeout-ms = <10 >;
            layers =<4>;

            key-positions = <81 93>;
            bindings = <&mt LSHIFT SPACE>;
        };
        combo_t6 {
            timeout-ms = <10 >;
            layers =<4>;

            key-positions = <81 93>;
            bindings = <&gresc>;
        };
    };

    td0 {
        compatible = "zmk,behavior-tap-dance";
        label = "TAPD_LAYER";
        #binding-cells = <1>;
        tapping-term-ms = <350>;
        bindings =<&mo 0>,<&mo 0>,<&mo 0>,<&mo 0>,<&to 0>;
    };
    ZMK_MACRO(bt_pair0, bindings = <&bt BT_PAIR 0>;)
    ZMK_MACRO(bt_pair1, bindings = <&bt BT_PAIR 1>;)
    ZMK_MACRO(bt_pair2, bindings = <&bt BT_PAIR 2>;)
    ZMK_MACRO(bt_pair3, bindings = <&bt BT_PAIR 3>;)
    ZMK_MACRO(bt_recon_0, bindings = <&bt BT_SEL 0>;)
    ZMK_MACRO(bt_recon_1, bindings = <&bt BT_SEL 1>;)
    ZMK_MACRO(bt_recon_2, bindings = <&bt BT_SEL 2>;)
    ZMK_MACRO(bt_recon_3, bindings = <&bt BT_SEL 3>;)



    bt_pair_0: bt_pair_0 {
        compatible = "zmk,behavior-hold-tap";
        label = "bt_pair0";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;
        bindings = <&bt_pair0>, <&bt_recon_0>;
    };
    bt_pair_1: bt_pair_1 {
        compatible = "zmk,behavior-hold-tap";
        label = "bt_pair1";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;
        bindings = <&bt_pair1>, <&bt_recon_1>;
    };
    bt_pair_2: bt_pair_2 {
        compatible = "zmk,behavior-hold-tap";
        label = "bt_pair2";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;
        bindings = <&bt_pair2>, <&bt_recon_2>;
    };
    bt_pair_3: bt_pair_3 {
        compatible = "zmk,behavior-hold-tap";
        label = "bt_pair3";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;
        bindings = <&bt_pair3>, <&bt_recon_3>;
    };
    uc:user_custom {
        compatible = "zmk,behavior-key-press";
        label ="user_custom";
        #binding-cells =<1>;
    };

    keymap {
        compatible = "zmk,keymap";

        // ============================================================
        // Layer 0: LalaPadGen2 DEFAULT_LAYER (QWERTY + Home Row Mods)
        //   B1 Pro F-row / number row / thumb row keep their original
        //   bindings; HRMs are overlaid on Q W R / A S F / Z C only.
        // ============================================================
        default_layer {
            bindings = <
//          //ESC          //f1                   //f2                   //f3                                   //f4                  //f5                //f6           //f7             //f8                //f9         //f10        //f11                //f12               //DEL
            &kp ESC        &kp C_BRIGHTNESS_DEC   &kp C_BRIGHTNESS_INC   &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS      &kp C_AC_MAC_LAUNCH   &kp C_AC_SEARCH     &kp C_AL_LOCK  &kp C_PREVIOUS   &kp C_PLAY_PAUSE    &kp C_NEXT   &kp C_MUTE   &kp C_VOLUME_DOWN    &kp C_VOLUME_UP     &kp DEL
            &kp GRAVE      &kp N1                 &kp N2                 &kp N3                                 &kp N4                &kp N5              &kp N6         &kp N7           &kp N8              &kp N9       &kp N0       &kp MINUS            &kp EQUAL           &kp INT3            &kp BSPC
            &kp TAB        &mt_tap ESCAPE Q       &mt LGUI W             &kp E                                  &mt_tap INT4 R        &kp T               &kp Y          &kp U            &kp I               &kp O        &kp P        &kp LBKT             &kp RBKT
            &kp CLCK       &mt LCTRL A            &mt LALT S             &kp D                                  &mt_tap INT5 F        &kp G               &kp H          &kp J            &kp K               &kp L        &kp SEMI     &kp SQT              &kp NUHS            &kp RET
            &kp LSHFT                             &mt LSHIFT Z           &kp X                                  &mt_tap CAPSLOCK C    &kp V               &kp B          &kp N            &kp M               &kp COMMA    &kp DOT      &kp FSLH             &kp INT1            &kp RSHFT
            &kp LCTRL      &uc LALT               &uc LCMD               &kp LANG2              &kp SPACE                                                 &kp LANG1                       &uc RCMD            &mo 1        &kp LEFT     &kp UP               &kp DOWN            &kp RIGHT
            &mo 2          &out OUT_BLE           &out OUT_24G           &out OUT_CHG                           &out OUT_CHGD
            >;
        };

        // ============================================================
        // Layer 1: LalaPadGen2 SECONDARY (numbers + symbols + F1-F12)
        //   B1 Pro F-row keeps F1-F12, number row keeps BT-pair tools.
        //   QWERTY/Home/Bottom rows host the LalaPad SECONDARY map.
        // ============================================================
        layer_one {
            bindings = <
            &trans      &kp F1                  &kp F2                  &kp F3                              &kp F4                  &kp F5              &kp F6          &kp F7          &kp F8              &kp F9      &kp F10     &kp F11             &kp F12             &trans
            &trans      &bt_pair_0 0 0          &bt_pair_1 0 0          &bt_pair_2 0 0                      &bt_pair_3 0 0          &trans              &trans          &trans          &trans              &trans      &trans      &trans              &kp C_AC_SEARCH     &trans              &trans
            &trans      &kp SLASH               &mt LWIN BACKSLASH      &kp MINUS                           &kp SINGLE_QUOTE        &kp EQUAL           &kp F1          &kp F2          &kp F3              &kp F4      &kp F5      &trans              &trans
            &trans      &mt LCTRL N1            &mt LALT N2             &mt LBKT N3                         &mt RBKT N4             &mt_tap F5 N5       &kp F6          &kp F7          &kp F8              &kp F9      &kp F10     &trans              &trans              &trans
            &trans                              &mt LSHIFT N6           &mt_tap COMMA N7                    &mt_tap DOT N8          &mt_tap SEMI N9     &mt_tap BACKSLASH N0  &kp F11   &kp F12             &kp LBKT    &kp RBKT    &kp BACKSLASH       &trans              &trans
            &trans      &trans                  &trans                  &trans                  &trans                                                                  &trans                              &kp RCTRL   &trans      &kp HOME            &kp PG_UP           &kp PG_DN           &kp END
            &none       &none                   &none                   &none                               &none
            >;
        };

        // ============================================================
        // Layer 2: LalaPadGen2 TERTIARY (navigation + mouse)
        //   F-row, number row and thumb row are &trans (fall through
        //   to layer 0). Mouse keys (&mkp / &msc / tp_*) require
        //   CONFIG_ZMK_POINTING=y in the .conf.
        // ============================================================
        layer_two {
            bindings = <
            &trans      &trans                  &trans                  &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans      &trans              &trans              &trans
            &trans      &trans                  &trans                  &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans      &trans              &trans              &trans              &trans
            &trans      &mt_tap PRINTSCREEN ESCAPE  &mt LWIN PERIOD     &tp_msc_up_left                     &tp_mkp_mb4_mb5         &kp TAB             &mt_tap END HOME &kp UP_ARROW   &kp TAB             &kp RWIN    &kp ESCAPE  &trans              &trans
            &trans      &mt LCTRL MINUS         &mt LALT ENTER          &tp_msc_down_right                  &mkp MB1                &mkp MB3            &kp LEFT_ARROW  &kp DOWN        &kp RIGHT           &mt ENTER RIGHT_ALT  &kp RIGHT_CONTROL  &trans  &trans              &trans
            &trans                              &mt LSHIFT INSERT       &kp BACKSPACE                       &kp SPACE               &mkp MB2            &kp DEL         &kp PAGE_UP     &kp PAGE_DOWN       &kp SPACE   &kp BACKSPACE  &kp RSHIFT       &trans              &trans
            &trans      &trans                  &trans                  &trans                  &trans                                                                  &trans                              &trans      &trans      &trans              &trans              &trans
            &trans      &trans                  &trans                  &trans                              &trans
            >;
        };

        // ============================================================
        // Layer 3: LalaPadGen2 SYSTEM (BT / media / brightness / sys)
        //   Access: NOT BOUND. Define an access key or combo as needed
        //   (e.g. set position 81 on layer 1 to `&mo 3`, or add a combo).
        //   F-row, number row and thumb row are &trans (fall through).
        //   zip_dyn_scale (trackpad DPI) keys are &trans -- B1 Pro has
        //   no trackpad hardware.
        // ============================================================
        layer_three {
            bindings = <
            &trans      &trans                  &trans                  &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans      &trans              &trans              &trans
            &trans      &trans                  &trans                  &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans      &trans              &trans              &trans              &trans
            &trans      &kp C_MUTE              &mt_tap C_BRIGHTNESS_DEC C_BRIGHTNESS_INC                   &kp K_CONTEXT_MENU      &kp UP              &mt END HOME    &out OUT_TOG    &bt BT_SEL 0        &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3   &trans              &trans
            &trans      &mt LCTRL C_VOLUME_UP   &mt LALT ENTER          &kp LEFT                            &kp DOWN                &kp RIGHT           &sys_reset      &mkp MB1        &bt BT_CLR          &bt BT_CLR_ALL  &bootloader  &trans            &trans              &trans
            &trans                              &mt LSHIFT C_VOLUME_DOWN  &kp BSPC                          &kp PG_UP               &kp PG_DN           &kp DEL         &trans          &trans              &trans      &trans      &trans              &trans              &trans
            &trans      &trans                  &trans                  &trans                  &trans                                                                  &trans                              &trans      &trans      &trans              &trans              &trans
            &trans      &trans                  &trans                  &trans                              &trans
            >;
        };
    };
};
